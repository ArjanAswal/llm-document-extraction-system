{
  "name": "llm-document-extraction-system",
  "version": "1.0.0",
  "description": "LLM-powered multilingual utility invoice extraction pipeline",
  "type": "module",
  "main": "dist/cli/extract.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "extract": "tsx src/cli/extract.ts",
    "server": "tsx src/cli/server.ts",
    "worker": "tsx src/cli/worker.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "web:build": "vite build --config web/vite.config.ts",
    "test:e2e": "npm run web:build && playwright test"
  },
  "keywords": [
    "llm",
    "invoice",
    "extraction",
    "gemini",
    "langchain"
  ],
  "license": "MIT",
  "overrides": {
    "@babel/generator": "7.29.12",
    "@babel/helper-module-transforms": "7.29.7",
    "@babel/helper-string-parser": "7.29.11",
    "@babel/helpers": "7.29.10",
    "@babel/parser": "7.29.12",
    "@babel/runtime": "7.29.10",
    "@babel/traverse": "7.29.12",
    "@babel/types": "7.29.11",
    "@jridgewell/resolve-uri": "3.1.2",
    "@types/estree": "1.0.10",
    "baseline-browser-mapping": "2.11.35",
    "browserslist": "4.29.5",
    "caniuse-lite": "1.0.30001820",
    "csstype": "3.2.3",
    "electron-to-chromium": "1.5.475",
    "node-releases": "2.0.63",
    "rollup": "4.67.4",
    "update-browserslist-db": "1.3.4",
    "ws": "8.22.1"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "franc": "^6.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^7.1.2",
    "vitest": "^4.1.7"
  }
}
